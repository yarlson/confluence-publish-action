{
	"name": "confluence-publish-action",
	"version": "0.1.1",
	"private": true,
	"description": "GitHub Action that publishes a folder of Markdown files as a Confluence page tree",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
		"check": "biome check . && tsc --noEmit && vitest run",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:live": "CONFLUENCE_LIVE=1 vitest run test/live.test.ts"
	},
	"dependencies": {
		"@actions/core": "3.0.1",
		"github-slugger": "2.0.0",
		"image-size": "2.0.4",
		"mdast-util-from-markdown": "2.1.0",
		"mdast-util-frontmatter": "2.0.1",
		"mdast-util-gfm": "3.1.0",
		"micromark-extension-frontmatter": "2.0.0",
		"micromark-extension-gfm": "3.0.0",
		"minimatch": "10.2.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/mdast": "4.0.4",
		"@types/node": "26.6.5",
		"esbuild": "0.28.2",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
